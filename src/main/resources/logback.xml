<?xml version="1.0" encoding="UTF-8"?>
<!--
    Phase 10 (requirement.md section 16): without this file, SLF4J/Logback falls back to
    Logback's own zero-config BasicConfigurator - console-only, root level DEBUG, no file
    appender, no rotation, and every third-party library (Selenium's HTTP client, Appium's,
    Apache POI, TestNG itself) logging at whatever level it feels like straight into the same
    stream as the framework's own action-level logs. This makes that configuration explicit
    and deliberate instead.

    [%X{test}] carries the currently-invoking TestNG method's "ClassName.methodName", set by
    com.framework.listeners.TestLoggingContextListener - the one piece of context %thread
    alone does not give you once several tests share a pooled thread under
    parallel="methods"/"classes" (requirement.md section 20).

    %maskedMsg (com.framework.secrets.MaskingMessageConverter, registered below) replaces the
    standard %msg conversion word - every line through CONSOLE/FILE is passed through
    SensitiveDataMasker.mask(...) unconditionally before being written, so masking no longer
    depends on the log call site remembering to call .mask() itself (audit finding: it
    previously did, framework-wide). See that class's own javadoc for exactly what this does
    and does not cover.
-->
<configuration>

    <conversionRule conversionWord="maskedMsg" class="com.framework.secrets.MaskingMessageConverter"/>

    <property name="LOG_DIR" value="logs"/>
    <property name="LOG_PATTERN" value="%d{HH:mm:ss.SSS} [%thread] [%X{test}] %-5level %logger{36} - %maskedMsg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/framework.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/framework-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Mirrors log events into the current Extent test node (com.framework.reporting.
         ExtentLoggingAppender's own javadoc has the full rationale). No encoder/pattern - it
         logs into Extent's own model, not text output. -->
    <appender name="EXTENT" class="com.framework.reporting.ExtentLoggingAppender"/>

    <!-- Mirrors the same business-narrative log events into Allure as steps, when Allure is
         enabled (com.framework.reporting.AllureLoggingAppender's own javadoc has the full
         rationale) - closes the "Allure has no bridge for arbitrary log lines" gap this
         README used to document as a known limitation. -->
    <appender name="ALLURE_STEPS" class="com.framework.reporting.AllureLoggingAppender"/>

    <!-- Framework/test code: DEBUG is the point of "detailed action-level logging" - see
         com.framework.web.WebActions, com.framework.mobile.MobileActions, com.framework.api.ApiClient.
         Not attached to EXTENT here (except com.framework.api below) - only the curated
         business-narrative loggers below are, so the report reads as "what the test did" (one
         line per real action, in plain language, already carrying its own value) rather than
         duplicating every low-level Selenium/Appium interaction underneath it. All of it still
         reaches CONSOLE/FILE via the root logger below (Logback loggers propagate to their
         ancestors' appenders by default).
         Found in practice: SecretManager/ConfigManager's own one-time startup log lines are
         ordinary com.framework logging too, so before this split they landed inside whichever
         test happened to be the first to touch either class - misattributed, not that test's
         own action at all. ExtentReportingListener#onStart now forces both to initialize
         before any test node exists, so they never had a home in Extent in the first place. -->
    <logger name="com.framework" level="DEBUG"/>
    <logger name="com.tests" level="DEBUG"/>

    <!-- com.framework.api (ApiClient) does NOT get an EXTENT appender-ref here, unlike the
         com.tests.application.* loggers below - not because it has nothing worth showing (it's
         the opposite: unlike Web/Mobile, an API test has no richer narrative layer underneath it
         to fall back on), but because a generic text mirror cannot render it usefully: Extent's
         Spark theme places a log message inside a plain HTML <td> with no `white-space: pre`
         anywhere in its bundled CSS (verified live - grepped the generated report's own <style>
         block), so even an already pretty-printed, multi-line JSON body still renders as one
         squished, whitespace-collapsed line in an actual browser regardless of how it looks in
         the raw HTML source or in a console. ApiClient calls ExtentManager.logCodeBlock(...)
         directly instead, which renders into a <textarea readonly> - whitespace-preserving by
         native HTML semantics, no CSS/JS dependency required - see that method's own javadoc for
         why the seemingly-more-correct MarkupHelper.createCodeBlock(json, CodeLanguage.JSON)
         overload was rejected instead (verified live: silently broken in this project's
         self-contained Spark HTML, not assumed). This mirrors ScreenshotCaptureListener's own
         precedent - reach into Extent explicitly for content the generic Logback bridge can't
         represent well, rather than stretching that bridge to cover it. -->

    <!-- The business-narrative layer, per surface - Web/Mobile Page Objects and Components
         (com.tests.application.pages.*/com.tests.application.components.*, split by platform
         underneath), API Services (com.tests.application.services - application-specific, same
         as page objects/components, so it lives in src/test rather than com.framework; the
         business-level wrapper around com.framework.api.ApiClient, requirement.md section
         9/10's "userService.createUser(request)" layer). Each of these already logs one line
         per real action in plain language. Logged at their common parent package rather than
         one logger per web/mobile leaf - logback's hierarchy already covers
         com.tests.application.pages.web/com.tests.application.pages.mobile from
         com.tests.application.pages.
         Audit finding: these three logger names still read com.tests.pages/com.tests.components/
         com.tests.api.services from before the tests/application restructure - none of them
         matched any real package any more (the real ones all moved under
         com.tests.application.*), so none of this framework's own business-narrative logging
         had reached Extent since that restructure; only the bare test pass/fail node existed
         with nothing underneath it. Fixed by pointing these at where the code actually lives. -->
    <logger name="com.tests.application.pages" level="DEBUG">
        <appender-ref ref="EXTENT"/>
        <appender-ref ref="ALLURE_STEPS"/>
    </logger>
    <logger name="com.tests.application.components" level="DEBUG">
        <appender-ref ref="EXTENT"/>
        <appender-ref ref="ALLURE_STEPS"/>
    </logger>
    <logger name="com.tests.application.services" level="DEBUG">
        <appender-ref ref="EXTENT"/>
        <appender-ref ref="ALLURE_STEPS"/>
    </logger>

    <!-- Third-party libraries: their default verbosity is connection/protocol-level noise
         unrelated to what a test author needs to diagnose a failure - quieted deliberately so
         it does not bury the framework's own DEBUG logging above. -->
    <logger name="org.apache.http" level="WARN"/>
    <logger name="org.apache.hc" level="WARN"/>
    <logger name="org.openqa.selenium" level="WARN"/>
    <logger name="io.appium" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.testng" level="WARN"/>
    <logger name="org.apache.poi" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
