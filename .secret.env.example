# Copy this file to .secret.env (already in .gitignore) and fill in real values.
# Never commit .secret.env — CI/CD should supply these as real environment
# variables instead, which SecretManager checks first (requirement.md section 13).

LOGIN_USERNAME=testuser
LOGIN_PASSWORD=secretPassword
API_CLIENT_ID=clientId
API_CLIENT_SECRET=clientSecret
EVENTHUB_EMAIL=your-eventhub-account@example.com
EVENTHUB_PASSWORD=your-eventhub-password

# Only needed if mobile.device.provider=BROWSERSTACK (default is LOCAL - see
# config/dev.properties "Mobile" section). From https://www.browserstack.com/accounts/settings.
BROWSERSTACK_USERNAME=your-browserstack-username
BROWSERSTACK_ACCESS_KEY=your-browserstack-access-key
